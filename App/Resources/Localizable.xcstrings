          }
        }
      }
    },
    "grid.error.usernameTaken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This username is already taken. Choose another one, or sign in if it is yours."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个用户名已被占用。请换一个；如果是你自己的账号，请直接登录。"
          }
        }
      }
    },
    "grid.info.dot": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A filled dot means the server location is known. A hollow dot means it is estimated from public reports; providers do not disclose where a request runs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实心圆点表示服务器地点已知，空心圆点表示根据公开资料推测。服务商不公开每个请求在哪里处理。"
          }
        }
      }
    },
    "grid.infoOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is information only. The app never pauses, delays or schedules your work."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里只提供信息。App 不会暂停、推迟或安排你的任何任务。"
          }
        }
      }
    },
