    "general.dayWindow.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar day starts again at midnight. Last 24 hours always covers the 24 hours up to now, so the menu bar, popover, overview and terminal status line do not drop to zero at midnight. The daily summary notification and the Day report still use the calendar day."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自然日在每天 0 点重新开始计算。过去 24 小时始终统计截至此刻的 24 小时，所以菜单栏、弹出面板、实时概览和终端状态栏不会在 0 点归零。每日汇总通知和报告页的“日”仍按自然日计算。"
          }
        }
      }
    },
