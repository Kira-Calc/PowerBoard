    "sessions.chat.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on whether the Claude desktop app is frontmost and whether its window shows a Stop button. Chat content is not read."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据 Claude 桌面版是否在前台、窗口里是否有“停止”按钮判断，不读取聊天内容"
          }
