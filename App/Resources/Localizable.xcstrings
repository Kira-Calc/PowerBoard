          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未知"
          }
        }
      }
    },
    "grid.liveNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The level compares the grid now with its forecast for the next 24 hours (WattTime CO₂ percentile, 0 cleanest to 100 dirtiest). Locations are estimates from public reports."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等级比较的是电网此刻与它未来 24 小时的预测（WattTime CO₂ 百分位，0 最清洁、100 最不清洁）。地点根据公开资料推测。"
          }
        }
      }
    },
    "grid.loading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在获取…"
          }
        }
      }
    },
    "grid.mixed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each provider's level is the weighted result of its candidate locations, which can differ from each other at the same time. Hover over a level to see the percentile."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每家服务商的等级是各候选地区按权重合并的结果，各地区同一时刻的情况可能不同。把指针停在等级上可以看到百分位。"
          }
        }
      }
    },
    "grid.notConnected.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without an account, PowerBoard compares the latest published day with the previous 30 days. Sign in to WattTime below to see whether each grid is cleaner or less clean right now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不登录时，PowerBoard 会把最近发布的一天与之前 30 天比较，给出等级。在下方登录 WattTime 后，可以看到各电网此刻比接下来 24 小时更清洁还是更不清洁。"
          }
        }
      }
    },
    "grid.notConnected.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live grid data is not connected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
