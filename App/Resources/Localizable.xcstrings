      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Latest day · fossil-free %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近一天 · 清洁电力 %@"
          }
        }
      }
    },
    "grid.overview.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server grid cleanliness"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器电网洁净度"
          }
        }
      }
    },
    "grid.recent.asOf": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "as of %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截至 %@"
          }
        }
      }
    },
    "grid.recent.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a WattTime account, the level compares the latest published day with the 30 days before it in the same regions, by fossil-free share (solar, wind, hydro, nuclear and geothermal; battery storage left out), on the same 0 to 100 scale. Data comes from the US EIA Hourly Electric Grid Monitor, needs no account and is usually about a day late, so it describes that day, not the grid now. It is not saved with your usage records."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未登录 WattTime 时，等级的算法是：把最近发布的一天与同一地区之前 30 天比较清洁电力占比（太阳能、风电、水电、核电和地热，不计储能电池），换算成同样的 0 到 100 百分位。数据来自美国 EIA 小时电网监测，不需要账号，但通常晚一天左右发布，所以它描述的是那一天，不代表此刻的电网，也不会记录到你的用量中。"
          }
        }
      }
    },
    "grid.recent.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fossil-free share over the latest published day: about %1$@ (up to %2$@, EIA)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近一天的清洁电力占比约 %1$@（截至 %2$@，EIA）。"
          }
        }
      }
    },
    "grid.recentLevel.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Percentile %lld among the previous 30 days by fossil-free share (0 is cleanest). Data up to %@, from the US EIA."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按清洁电力占比，在过去 30 天中的百分位为 %lld（0 最清洁）。数据截至 %@，来自美国 EIA。"
          }
        }
      }
    },
    "grid.recentLevel.tag": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
