    "sources.chatAccess.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat keeps no usage records on this Mac, so it only appears in Active conversations. With Accessibility permission, PowerBoard checks whether the desktop app’s window shows a Stop button to tell that a reply is being written. Only button labels are compared; chat content is not read. Without it, the row only says the app was used recently."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "普通聊天不在本机记录用量，只能在活跃对话里显示状态。有辅助功能权限时，PowerBoard 查看桌面版窗口里有没有“停止”按钮来判断是否正在回复，只比对按钮名称，不读取聊天内容；没有权限时只显示最近用过。"
          }
        }
      }
    }
  },
  "version": "1.0"
