    "grid.staticNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Carbon intensity values are yearly averages from US EPA eGRID2023. Locations are estimates from public reports."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
