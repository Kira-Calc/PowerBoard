    "info.carbon.basis": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The real grid mix of the data centers is not published. This value is a location-based average, not live grid data."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据中心实际使用的电网构成没有公开。这个数值是按地区的平均值，不是实时电网数据。"
          }
        }
      }
    },
    "info.carbon.formula": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Carbon (g) = energy (Wh) / 1000 x grid intensity (gCO₂e/kWh)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "碳排 (g) = 电量 (Wh) / 1000 x 电网碳强度 (gCO₂e/kWh)"
          }
        }
      }
    },
    "info.carbon.grid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grid intensity in use: %1$@ %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前电网碳强度：%1$@ %2$@"
          }
        }
      }
    },
    "info.carbon.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How carbon is estimated"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "碳排如何估算"
          }
        }
      }
    },
    "info.energy.cacheRatios": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache writes count as %1$@ and cache reads as %2$@ of an uncached input token."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缓存写入按未缓存输入 token 的 %1$@ 计入，缓存读取按 %2$@ 计入。"
          }
        }
      }
    },
    "info.energy.formula": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Effective input = uncached input + cache write x k_write + cache read x k_read\nEnergy (Wh) = effective input / 1e6 x E_in + output / 1e6 x E_out"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有效输入 = 未缓存输入 + 缓存写入 x k_write + 缓存读取 x k_read\n电量 (Wh) = 有效输入 / 1e6 x E_in + 输出 / 1e6 x E_out"
          }
        }
      }
    },
    "info.energy.range": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The range is the mid value x %1$@ to x %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "区间为中值的 %1$@ 倍到 %2$@ 倍。"
          }
        }
      }
    },
    "info.energy.scope": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inference energy is the electricity AI providers' data centers use to run the models for your requests. It is estimated from token counts and does not include this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推理耗电是 AI 服务商的数据中心运行模型、处理你的请求时消耗的电量。根据 token 数量估算，不含本机耗电。"
          }
        }
      }
    },
    "info.energy.title": {
      "extractionState": "manual",
