            "value": "WattTime did not accept this username or password. If you just created the account, open the link in the verification email first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WattTime 不接受这个用户名或密码。如果刚注册，请先点开验证邮件中的链接。"
          }
        }
      }
    },
    "grid.error.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
