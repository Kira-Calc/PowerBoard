    "autoExport.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While the app is running, after this time each day, the previous complete day, week or month is saved to the folder. The byline set in the export dialog is used here too."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 运行时，每天到这个时间后，把上一个完整的日、周或月的报告保存到文件夹。署名使用导出窗口中的设置。"
          }
        }
      }
    },
